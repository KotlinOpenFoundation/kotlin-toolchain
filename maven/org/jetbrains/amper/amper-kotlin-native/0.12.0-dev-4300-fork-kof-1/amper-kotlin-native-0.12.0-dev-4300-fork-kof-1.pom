<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata, -->
  <!-- which should be used instead. Do not delete the following line which -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jetbrains.amper</groupId>
  <artifactId>amper-kotlin-native</artifactId>
  <version>0.12.0-dev-4300-fork-kof-1</version>
  <name>amper-kotlin-native</name>
  <description>Kotlin/Native distribution provisioning and helpers for the Kotlin Toolchain.

These declarations hold the rules for how the Kotlin Toolchain works
with Kotlin/Native, and these rules can be shared with the IDE plugin so the
behavior is aligned.
</description>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>core</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>frontend-api</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>kotlin-native-rules</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>maven-central-configuration</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>system-info</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.4.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
