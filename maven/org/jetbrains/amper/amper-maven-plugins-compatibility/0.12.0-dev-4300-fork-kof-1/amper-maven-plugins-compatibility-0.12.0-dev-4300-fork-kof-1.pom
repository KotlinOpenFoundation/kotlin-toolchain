    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>dependency-resolution</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>schema</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>dr</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>amper-build-info</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.amper</groupId>
      <artifactId>amper-maven-plugin-download</artifactId>
      <version>0.12.0-dev-4300-fork-kof-1</version>
